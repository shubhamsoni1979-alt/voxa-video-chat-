# Frontend API Configuration
VITE_API_URL=https://voxa-video-chat.onrender.com

# Backend Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://voxa-video-chat.vercel.app

# Redis Configuration (Optional for local dev, auto-falls back to in-memory)
REDIS_URL=redis://localhost:6379

# Backend WebRTC TURN Configuration (Never expose real TURN credentials in VITE_ variables)
METERED_API_KEY=
METERED_APP_NAME=

TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
